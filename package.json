{
  "name": "gpt-chat",
  "version": "1.0.0",
  "description": "Локальный десктопный чат с OpenAI",
  "main": "main.js",
  "author": "Роман",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "docx": "^9.7.2",
    "dotenv": "^16.4.7",
    "jszip": "^3.10.2",
    "marked": "^18.0.14",
    "openai": "^4.85.4",
    "win-ca": "^3.5.1"
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.gptchat",
    "productName": "GPT Chat",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "storage.js",
      "openai-client.js",
      "models.js",
      "files.js",
      "local-files.js",
      "usage.js",
      "build/icon.png",
      "build/icon.ico",
      "renderer/**/*",
      "package.json"
    ],
    "extraFiles": [],
    "asarUnpack": [
      "node_modules/win-ca/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
